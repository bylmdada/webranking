# Google Indexing API - Service Account JSON key (base64 encoded)
GOOGLE_SERVICE_ACCOUNT_KEY=

# IndexNow API key (generate a random string, e.g. uuid)
INDEXNOW_API_KEY=

# Optional: run specific modules only (comma-separated: audit,gsc,visit,search,indexing,indexnow)
# gsc reuses GOOGLE_SERVICE_ACCOUNT_KEY; add that service account as a user on each Search Console property first.
RUN_MODULES=audit

# Optional: simulation speed profile (default or ci)
SIMULATION_PROFILE=default

# Optional: print intended actions without opening browsers or calling external APIs
DRY_RUN=false
